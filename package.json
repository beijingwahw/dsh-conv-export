{
  "name": "@dsh-external/dsh-conv-export",
  "version": "0.1.0",
  "type": "module",
  "description": "dsh-conv-export（对话导出）— export the current DeepSeek Harness conversation as Markdown, PDF, or a long PNG image.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "node --expose-internals --import tsx ./node_modules/@deepseek-ai/cordis/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preinstall": "node -e \"const a=process.env.npm_config_user_agent||'';if(!/pnpm/.test(a)){console.error('[preinstall] 本项目约定使用 pnpm 安装依赖，请先执行 npm i -g pnpm；已拦截 npm/yarn。');process.exit(1)}\""
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "^1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.18",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "patchedDependencies": {
      "@deepseek-ai/cordis-plugin-hmr@1.0.16": "patches/@deepseek-ai__cordis-plugin-hmr.patch"
    }
  }
}
